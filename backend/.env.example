# The public origin browsers use, e.g. https://truckbhai.example. Set this when
# running behind a reverse proxy: the CSRF origin check and the password reset
# link are both built from it.
# PUBLIC_ORIGIN=

# Timezone for comparing booking dates against today. Defaults to Asia/Kolkata.
# BUSINESS_TIMEZONE=Asia/Kolkata

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=truckbhai

# Optional EmailJS confirmations for the contact and subscription forms
# EMAILJS_SERVICE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# EMAILJS_CONTACT_TEMPLATE_ID=template_ciek2zs
# EMAILJS_NEWSLETTER_TEMPLATE_ID=template_3utpi5l
# Optional welcome email sent when a customer account is created
# EMAILJS_WELCOME_TEMPLATE_ID=
# Required for password reset links to actually be delivered
# EMAILJS_RESET_TEMPLATE_ID=

# Optional map provider overrides
# PHOTON_URL=https://photon.komoot.io/api/
# OSRM_URL=http://127.0.0.1:5000/

# Admin password as a scrypt salt:hash. See the README for setup.
# ADMIN_PASSWORD_HASH=
# Optional second password for the same dashboard.
# ADMIN_SECOND_PASSWORD_HASH=
# Enable when the admin page is served over HTTPS.
# ADMIN_SECURE_COOKIE=true
